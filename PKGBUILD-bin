    '2a022becf7cf19460f0ec2a04f483446d0408abd66467f5a719184e8965ab9b1'
    'eb250b5d739669135e041b6e800ea5b09d4c07103985925430c6f6bb93e96db0'
)

package() {
    install -Dm755 lavanda                 "$pkgdir/usr/bin/lavanda"
